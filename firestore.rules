rules_version = '2';

// Kimlik: Google ile giriş. Herkes sadece kendi verisini okur ve yazar.
// users/{uid}: hedefler. users/{uid}/days/{tarih}: öğünler ve antrenman. users/{uid}/weights/{tarih}: kilo.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == uid;
    }

    function validDate(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['targets'])
        && request.resource.data.targets.kcal is number
        && request.resource.data.targets.kcal >= 1500 && request.resource.data.targets.kcal <= 5000
        && request.resource.data.targets.protein is number
        && request.resource.data.targets.protein >= 40 && request.resource.data.targets.protein <= 250;

      match /days/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDate(date)
          && request.resource.data.meals is map
          && request.resource.data.extras is map
          && request.resource.data.custom is list && request.resource.data.custom.size() <= 50;
      }

      match /weights/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDate(date)
          && request.resource.data.keys().hasOnly(['kg'])
          && request.resource.data.kg is number
          && request.resource.data.kg >= 30 && request.resource.data.kg <= 150;
      }
    }
  }
}
